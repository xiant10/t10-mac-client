# Room Credential Acquisition:
#
# Option A: Auth Service Room Admission (recommended production pattern).
# The client acquires a scoped room token and principal assertion from POST /v1/rooms/admission.
# AUTH_URL=http://localhost:8081
# AUTH_TOKEN=bearer-token-here
# Or supply login credentials to auto-login:
# AUTH_USERNAME=ada@acme.example
# AUTH_PASSWORD=change-me-enterprise-admin
# AUTH_TENANT=ten_acme
#
# Option B: Local Token Minting (explicit development mode).
# Self-signs a token with a local LiveKit API secret. Keys must match livekit-agent/.env.
LIVEKIT_URL=ws://localhost:8880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-32-plus-character-secret

LOG_LEVEL=info

# OpenTelemetry: OTLP/gRPC host:port (no scheme) to export traces and
# metrics to — the agent's docker-compose.yml otel-collector service,
# published to the host at 4317 (see livekit-agent/docker-compose.yml). Leave unset
# to disable tracing/metrics export entirely (logs still get a correlation
# ID either way — see internal/telemetry). Requires
# `docker compose up otel-collector jaeger prometheus` running from livekit-agent/.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
